    Name="JTmenu"
    AppVersion="3.0.0"
    Description="JTmenu - nadstavba pre AutoCAD/Civil 3D"
    Author="Jakub Tomecko"
    ProductCode="{8D815BA1-0175-48ED-B0D3-710C560AC552}"
    UpgradeCode="{E7A1387F-2A32-4033-B90C-FF224506D1F2}">

  <CompanyDetails Name="Jakub Tomecko" Email="jakub.tomecko@gmail.com" />

  <RuntimeRequirements OS="Win32|Win64" Platform="AutoCAD|AutoCAD*|Civil3D" />

  <Components Description="JTmenu">
    <RuntimeRequirements
        SupportPath="./Contents;./Contents/functions;./Contents/functions/content;./Contents/icons;./Contents/resource;./Contents/resource/blocks;./Contents/resource/blocks/CZK;./Contents/resource/blocks/ENG;./Contents/resource/blocks/SVK;./Contents/resource/blocks/KnihovnaZDZ;./Contents/resource/blocks/KnihovnaZDZ/1xx;./Contents/resource/blocks/KnihovnaZDZ/2xx;./Contents/resource/blocks/KnihovnaZDZ/3xx;./Contents/resource/blocks/KnihovnaZDZ/4xx;./Contents/resource/blocks/KnihovnaZDZ/5xx;./Contents/resource/blocks/KnihovnaZDZ/1xx_J;./Contents/resource/blocks/KnihovnaZDZ/2xx_J;./Contents/resource/blocks/KnihovnaZDZ/3xx_J;./Contents/resource/blocks/KnihovnaZDZ/4xx_J;./Contents/resource/blocks/KnihovnaZDZ/5xx_J;./Contents/resource/documents;./Contents/resource/lines;./Contents/resource/toolpallete"
        ToolPalettePath="./Contents/resource/toolpallete" />
    <ComponentEntry AppName="JTmenu"
